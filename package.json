{
  "name": "@tantrancover/liquid-tabs",
  "version": "0.1.0",
  "description": "Floating Liquid Glass tab bar for iOS 26+ (bar only) — built on public UIGlassEffect / UIGlassContainerEffect. Host provides the native view; mini-apps consume it as a Module Federation shared singleton.",
  "license": "UNLICENSED",
  "private": false,
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "ios",
    "tantrancover-liquid-tabs.podspec",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.85.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.25.0",
    "@babel/preset-react": "^7.24.0",
    "@babel/preset-typescript": "^7.24.0",
    "@react-native/babel-preset": "^0.85.2",
    "@react-native/jest-preset": "^0.85.2",
    "@types/jest": "^29.5.12",
    "@types/react": "^19.2.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "react": "19.2.3",
    "react-native": "0.85.2",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.6.0"
  },
  "codegenConfig": {
    "name": "liquidtabs",
    "type": "all",
    "jsSrcsDir": "./src/specs",
    "ios": {
      "componentProvider": {
        "LiquidTabBar": "LiquidTabBarComponentView"
      }
    }
  }
}
